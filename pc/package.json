{
  "name": "hongguo-manju-electron",
  "version": "1.0.0",
  "description": "红果漫剧 PC 播放器（Electron 版）——独立桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hongguo.manju",
    "productName": "红果漫剧",
    "copyright": "Copyright © 2026 红果漫剧",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "backend/dist_backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果漫剧",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "红果漫剧_安装版_Setup_${version}.${ext}"
    },
    "electronLanguages": [
      "zh-CN"
    ]
  },
  "dependencies": {
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5"
  }
}
